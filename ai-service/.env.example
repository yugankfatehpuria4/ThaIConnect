PORT=5001

# Grok / xAI chat — get a valid key from https://console.x.ai
OPENAI_API_KEY=xai-your-key-from-console-x-ai
OPENAI_BASE_URL=https://api.x.ai/v1
AI_CHAT_MODEL=grok-3

# Comma-separated backend origins allowed by CORS.
BACKEND_ORIGINS=http://localhost:5002,http://127.0.0.1:5002

# Shared secret between backend and this service (any long random string).
# Must match AI_SERVICE_API_KEY in backend/.env — NOT the xAI key above.
AI_SERVICE_API_KEY=change-me-to-a-long-random-secret
